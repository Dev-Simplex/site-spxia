# Copy this file to .env.local and fill in real values
# Never commit .env or .env.local — see .gitignore

# Supabase (public — safe in browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Products section gate — "true" shows the section, anything else hides it
NEXT_PUBLIC_SHOW_PRODUCTS=false

# Google reCAPTCHA v2 site key — required for /diagnostico form (when ported)
# Get from https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ---- Edge function envs (set via `supabase secrets set` or dashboard, NOT here) ----
# ASAAS_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
